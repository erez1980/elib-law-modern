---
// Self-hosted fonts: the Google Fonts stylesheet was the single biggest
// render blocker (750ms for the CSS alone, before any font file). Serving
// them from our own origin removes that request and two extra connections.
// Only the subsets and weights actually rendered are imported.
// Bellefair carries the display type (one weight, used large); IBM Plex Sans
// Hebrew carries everything else.
import '@fontsource/bellefair/hebrew-400.css';
import '@fontsource/bellefair/latin-400.css';
import '@fontsource/ibm-plex-sans-hebrew/hebrew-400.css';
import '@fontsource/ibm-plex-sans-hebrew/hebrew-500.css';
import '@fontsource/ibm-plex-sans-hebrew/hebrew-600.css';
import '@fontsource/ibm-plex-sans-hebrew/latin-400.css';
import '@fontsource/ibm-plex-sans-hebrew/latin-600.css';
// The two faces that paint above the fold, preloaded so they are fetched
// alongside the CSS instead of after it parses.
import bodyFace from '@fontsource/ibm-plex-sans-hebrew/files/ibm-plex-sans-hebrew-hebrew-400-normal.woff2?url';
import headingFace from '@fontsource/bellefair/files/bellefair-hebrew-400-normal.woff2?url';
import FloatingActions from '../components/FloatingActions.astro';
import AccessibilityWidget from '../components/AccessibilityWidget.astro';
import Icon from '../components/Icon.astro';
import { site, navigation } from '../data/site';
import { withBase } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  ogType?: 'website' | 'article';
}

const { title = site.title, description = site.description, image = site.ogImage ?? site.heroImage, noIndex = false, ogType = 'website' } = Astro.props;
const homeHref = withBase('/');
const faviconPngHref = withBase('/favicon.png');
const faviconIcoHref = withBase('/favicon.ico');
const faviconSvgHref = withBase('/favicon.svg');
const appleTouchIconHref = withBase('/apple-touch-icon.png');
const ogImage = new URL(withBase(image), Astro.site ?? Astro.url).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const currentPath = (Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/').replace(/(.)\/$/, '$1');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['LegalService', 'Attorney'],
  '@id': 'https://elib-law.co.il/#office',
  name: site.name,
  description: site.description,
  url: new URL(homeHref, Astro.site ?? Astro.url).toString(),
  image: ogImage,
  telephone: site.phone,
  email: site.email,
  areaServed: [
    { '@type': 'City', name: 'קדימה צורן' },
    { '@type': 'City', name: 'נתניה' },
    { '@type': 'City', name: 'כפר סבא' },
    { '@type': 'City', name: 'רעננה' },
    { '@type': 'City', name: 'הוד השרון' },
    { '@type': 'AdministrativeArea', name: 'השרון' },
  ],
  sameAs: site.facebook ? [site.facebook] : [],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'רחוב ראשי שדות 16',
    addressLocality: 'קדימה צורן',
    postalCode: '6092000',
    addressCountry: 'IL',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 32.2781,
    longitude: 34.9169,
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'], opens: '09:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '08:00', closes: '13:00' },
  ],
  founder: {
    '@type': 'Person',
    name: 'אליזבט ברזאני דדון',
    jobTitle: 'עורכת דין ומגשרת',
  },
  knowsAbout: ['דיני משפחה', 'גירושין', 'גישור משפחתי', 'מזונות ילדים', 'משמורת והסדרי שהות', 'חלוקת רכוש', 'צוואות וירושות', 'ייפוי כוח מתמשך', 'הסכמי ממון'],
};
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1e2d27" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" as="font" type="font/woff2" href={headingFace} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={bodyFace} crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href={faviconSvgHref} />
    <link rel="icon" type="image/png" sizes="512x512" href={faviconPngHref} />
    <link rel="icon" href={faviconIcoHref} sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconHref} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <link rel="canonical" href={canonicalUrl} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="he_IL" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline src={withBase("/js/prefs-init.js")}></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      const gtag = (...args) => window.dataLayer.push(args);
      gtag('js', new Date());
      gtag('config', 'G-RD52L2GWWH');
      // gtag.js is 161KB and nothing on the page depends on it, so fetch it
      // only once the page has loaded. Calls made before then sit in
      // dataLayer and are processed as soon as the tag arrives.
      addEventListener('load', () => {
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-RD52L2GWWH';
        document.head.appendChild(s);
      }, { once: true });
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">דילוג לתוכן הראשי</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href={homeHref} class="brand">
          <img src={withBase('/images/eb-mark.svg')} alt="" width="421" height="257" class="brand-mark" />
          <div class="brand-text">
            <strong>{site.shortName}</strong>
            <span>{site.tagline}</span>
          </div>
        </a>
        <nav class="nav" aria-label="ניווט ראשי">
          {navigation.map((item) => {
            const href = withBase(item.href);
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            return <a href={href} aria-current={isActive ? 'page' : undefined} class={isActive ? 'active' : ''}>{item.label}</a>;
          })}
        </nav>
        <div class="header-actions">
          <a class="header-phone" href={`tel:${site.phone.replace(/-/g, '')}`}>{site.phone}</a>
          <details class="mobile-menu">
            <summary aria-label="פתיחת תפריט"><Icon name="menu" size={20} /></summary>
            <nav class="mobile-menu-panel" aria-label="ניווט מובייל">
              {navigation.map((item) => {
                const href = withBase(item.href);
                const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
                return <a href={href} aria-current={isActive ? 'page' : undefined} class={isActive ? 'active' : ''}>{item.label}</a>;
              })}
            </nav>
          </details>
          <button class="theme-toggle" type="button" aria-label="שינוי מצב תצוגה" title="שינוי מצב תצוגה">
            <Icon name="sun" size={20} class="theme-toggle-icon theme-toggle-sun" />
            <Icon name="moon" size={20} class="theme-toggle-icon theme-toggle-moon" />
          </button>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <FloatingActions />
    <AccessibilityWidget />
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand-col">
          <img src={withBase('/images/eb-mark.svg')} alt="" width="421" height="257" class="footer-mark" />
          <h3>{site.shortName}</h3>
          <p>{site.description}</p>
        </div>
        <div>
          <h4>ניווט מהיר</h4>
          <ul>
            {navigation.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h4>יצירת קשר</h4>
          <ul>
            <li><a href={`tel:${site.phone.replace(/-/g, '')}`}>{site.phone}</a></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li>{site.address}</li>
            {site.hours.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      </div>
      <div class="container footer-legal">
        <a href={withBase('/areas')}>אזורי שירות</a>
        <a href={withBase('/accessibility-statement')}>הצהרת נגישות</a>
        <a href={withBase('/privacy')}>מדיניות פרטיות</a>
        <span class="footer-copy">© {new Date().getFullYear()} {site.shortName}. התוכן באתר הוא מידע כללי ואינו מהווה ייעוץ משפטי.</span>
      </div>
    </footer>
    <script>
      (() => {
        const key = 'elib-theme';
        const root = document.documentElement;
        const toggle = document.querySelector('.theme-toggle');
        const applyTheme = (theme) => {
          root.dataset.theme = theme;
          localStorage.setItem(key, theme);
          toggle?.setAttribute('aria-pressed', String(theme === 'dark'));
        };
        if (toggle) {
          toggle.addEventListener('click', () => {
            const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
            applyTheme(next);
          });
          toggle.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
        }
      })();
    </script>
    <script>
      (() => {
        const header = document.querySelector('.site-header');
        const onScroll = () => header && header.classList.toggle('is-scrolled', window.scrollY > 24);
        onScroll();
        addEventListener('scroll', onScroll, { passive: true });

      })();
    </script>
  </body>
</html>

<style is:global>
  /* Palette: eucalyptus ink and Sharon-sage paper, with the gold of the EB
     monogram kept for hairlines and small accents only. */
  :root {
    --font-display: 'Bellefair', 'IBM Plex Sans Hebrew', Georgia, serif;
    --font-body: 'IBM Plex Sans Hebrew', Arial, sans-serif;
    --color-primary: #a87b22;
    --color-primary-deep: #7a5a16;
    --color-text: #1c2723;
    --color-muted: #56645e;
    --color-surface: #e6eae4;
    --color-surface-warm: #edf0eb;
    --color-border: #cbd3cc;
    --color-white: #f4f6f2;
    --color-page-top: #f4f6f2;
    --color-header: rgba(244, 246, 242, 0.94);
    --color-header-border: #d6ddd7;
    --color-card: #fafbf9;
    --color-card-strong: #ffffff;
    --color-overlay: rgba(30, 45, 39, 0.86);
    --color-overlay-text: rgba(232, 236, 230, 0.86);
    --color-pill-bg: #ece4cf;
    --color-pill-text: #7a5a16;
    --color-soft-text: #3a4741;
    --color-footer-bg-start: #1e2d27;
    --color-footer-bg-end: #1e2d27;
    --color-deep: #1e2d27;
    --color-deep-text: #e8ece6;
    --color-deep-muted: #a9b8b0;
    --color-ink-button: #1e2d27;
    --color-ink-button-text: #f4f6f2;
    --shadow-soft: 0 1px 2px rgba(28, 39, 35, 0.05);
    --shadow-strong: 0 14px 34px rgba(28, 39, 35, 0.1);
    --radius-md: 6px;
    --radius-sm: 3px;
    --container: min(1160px, calc(100vw - 2rem));
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
    --color-primary: #e5b34a;
    --color-primary-deep: #e8c87e;
    --color-text: #e8ece6;
    --color-muted: #a5b2ab;
    --color-surface: #18221e;
    --color-surface-warm: #1a2521;
    --color-border: rgba(232, 236, 230, 0.13);
    --color-white: #121a17;
    --color-page-top: #121a17;
    --color-header: rgba(18, 26, 23, 0.94);
    --color-header-border: rgba(232, 236, 230, 0.1);
    --color-card: #1a2521;
    --color-card-strong: #1e2a26;
    --color-overlay: rgba(10, 16, 14, 0.86);
    --color-overlay-text: rgba(232, 236, 230, 0.86);
    --color-pill-bg: rgba(229, 179, 74, 0.12);
    --color-pill-text: #e5c47c;
    --color-soft-text: #c9d2cc;
    --color-footer-bg-start: #0c1210;
    --color-footer-bg-end: #0c1210;
    --color-deep: #0e1613;
    --color-deep-text: #e8ece6;
    --color-deep-muted: #a5b2ab;
    --color-ink-button: #e5b34a;
    --color-ink-button-text: #1a1408;
    --shadow-soft: 0 1px 2px rgba(0, 0, 0, 0.3);
    --shadow-strong: 0 14px 34px rgba(0, 0, 0, 0.4);
    }
  }

  :root[data-theme='dark'] {
    --color-primary: #e5b34a;
    --color-primary-deep: #e8c87e;
    --color-text: #e8ece6;
    --color-muted: #a5b2ab;
    --color-surface: #18221e;
    --color-surface-warm: #1a2521;
    --color-border: rgba(232, 236, 230, 0.13);
    --color-white: #121a17;
    --color-page-top: #121a17;
    --color-header: rgba(18, 26, 23, 0.94);
    --color-header-border: rgba(232, 236, 230, 0.1);
    --color-card: #1a2521;
    --color-card-strong: #1e2a26;
    --color-overlay: rgba(10, 16, 14, 0.86);
    --color-overlay-text: rgba(232, 236, 230, 0.86);
    --color-pill-bg: rgba(229, 179, 74, 0.12);
    --color-pill-text: #e5c47c;
    --color-soft-text: #c9d2cc;
    --color-footer-bg-start: #0c1210;
    --color-footer-bg-end: #0c1210;
    --color-deep: #0e1613;
    --color-deep-text: #e8ece6;
    --color-deep-muted: #a5b2ab;
    --color-ink-button: #e5b34a;
    --color-ink-button-text: #1a1408;
    --shadow-soft: 0 1px 2px rgba(0, 0, 0, 0.3);
    --shadow-strong: 0 14px 34px rgba(0, 0, 0, 0.4);
  }

  :root[data-a11y-readable-font] {
    --font-display: Arial, Helvetica, sans-serif;
  }

  html {
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-white);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    line-height: 1.85;
    font-size: 1.02rem;
    background: var(--color-white);
  }

  * {
    box-sizing: border-box;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  :focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  img {
    max-width: 100%;
    /* The width/height attributes reserve space before load (no layout
       shift), but without this the height attribute also wins over any
       aspect-ratio set in CSS and the image renders at its full 1200px. */
    height: auto;
    display: block;
  }

  .skip-link {
    position: absolute;
    top: 0.75rem;
    inset-inline-start: 0.75rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-deep);
    color: var(--color-deep-text);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }

  .container {
    width: var(--container);
    margin-inline: auto;
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-header);
    border-bottom: 1px solid var(--color-header-border);
    backdrop-filter: blur(10px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    min-height: 78px;
    transition: min-height 200ms ease;
  }

  .site-header.is-scrolled .header-inner {
    min-height: 62px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }

  .brand-mark {
    height: 36px;
    width: auto;
    flex: 0 0 auto;
  }

  .brand strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.3rem;
    line-height: 1.15;
  }

  .brand span {
    color: var(--color-muted);
    font-size: 0.82rem;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 1.6rem;
    flex-wrap: wrap;
  }

  .nav a {
    position: relative;
    color: var(--color-soft-text);
    font-size: 0.97rem;
    padding: 0.4rem 0;
  }

  .nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0.1rem;
    height: 1px;
    background: var(--color-primary);
    transform: scaleX(0);
    transition: transform 180ms ease;
  }

  .nav a:hover::after,
  .nav a.active::after {
    transform: scaleX(1);
  }

  .nav a.active {
    color: var(--color-text);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .header-phone {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    direction: ltr;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-primary);
    line-height: 1.4;
  }

  .theme-toggle,
  .mobile-menu summary {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    display: inline-grid;
    place-items: center;
    cursor: pointer;
    position: relative;
  }

  .theme-toggle:hover,
  .mobile-menu summary:hover {
    border-color: var(--color-primary);
  }

  .theme-toggle-icon {
    position: absolute;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .theme-toggle-sun {
    opacity: 1;
  }

  .theme-toggle-moon {
    opacity: 0;
    transform: scale(0.7);
  }

  :root[data-theme='dark'] .theme-toggle-sun {
    opacity: 0;
    transform: scale(0.7);
  }

  :root[data-theme='dark'] .theme-toggle-moon {
    opacity: 1;
    transform: none;
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu-panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    z-index: 30;
    width: min(300px, calc(100vw - 2rem));
    display: grid;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-card-strong);
    box-shadow: var(--shadow-strong);
  }

  .mobile-menu-panel a {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .mobile-menu-panel a:last-child {
    border-bottom: 0;
  }

  .mobile-menu-panel a.active {
    color: var(--color-pill-text);
    font-weight: 600;
  }

  /* Buttons */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    border: 1px solid transparent;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .button-primary {
    background: var(--color-ink-button);
    color: var(--color-ink-button-text);
  }

  .button-primary:hover {
    background: var(--color-primary-deep);
    color: #fff;
  }

  :root[data-theme='dark'] .button-primary:hover {
    color: #1a1408;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .button-primary:hover {
      color: #1a1408;
    }
  }

  .button-secondary {
    background: transparent;
    border-color: currentColor;
    color: var(--color-text);
  }

  .button-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-pill-text);
  }

  /* Cross-document page transitions (progressive enhancement) */
  @view-transition {
    navigation: auto;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 200ms;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }

    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }

  /* Sections and type */
  .section {
    padding: 6rem 0;
  }

  .section-alt {
    background: var(--color-surface);
  }

  /* Small context line above a heading: plain gold text led by a short rule,
     not a pill. */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--color-pill-text);
    margin: 0 0 1rem;
  }

  .eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--color-primary);
    flex: 0 0 auto;
  }

  h1, h2, h3, h4 {
    margin: 0 0 1rem;
    letter-spacing: 0;
  }

  h1, h2 {
    font-family: var(--font-display);
    font-weight: 400;
