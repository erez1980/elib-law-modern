---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FaqPreview from '../components/FaqPreview.astro';
import Testimonials from '../components/Testimonials.astro';
import AreaLinks from '../components/AreaLinks.astro';
import { highlights, site } from '../data/site';
import { homePage } from '../data/home';
import { withBase } from '../utils/url';

const heroImage = withBase(site.heroImage);
const phoneHref = `tel:${site.phone.replace(/-/g, '')}`;
const facts = [
  { term: 'משנת 2008', text: 'חברת לשכת עורכי הדין' },
  { term: 'משפט וגישור', text: 'הדרך נבחרת לפי המקרה, לא לפי נוסחה' },
  { term: 'קדימה צורן', text: 'משרד בוטיק לתושבי נתניה והשרון' },
];
const warmth = [
  'שיחה ברורה, בלי מילים משפטיות שמעמיסות סתם',
  'בחינה אמיתית של האפשרויות, לא תגובה אוטומטית',
  'רגישות כשאפשר, ונחישות כשצריך',
  'תחושת סדר ובהירות כבר מהשלבים הראשונים',
];
const featuredServices = [
  { title: 'גירושין', text: 'ליווי משפטי מדויק בתחילת הדרך, במו״מ, בגישור או בהליך משפטי.', href: '/services/divorce-lawyer' },
  { title: 'מזונות ומשמורת', text: 'בניית מסגרת ברורה ויציבה לילדים ולהורים, עם ראייה מעשית ואנושית.', href: '/services/custody-lawyer' },
  { title: 'צוואות וירושות', text: 'עריכת צוואות, ליווי בירושות וטיפול במחלוקות משפחתיות רגישות.', href: '/services/will-lawyer' },
  { title: 'ייפוי כוח מתמשך', text: 'תכנון משפטי אחראי שנותן שקט נפשי לעתיד.', href: '/services/lasting-power-attorney-lawyer' },
];
// Hebrew letters as step ordinals, the way Hebrew documents number clauses.
const ordinals = ['א', 'ב', 'ג'];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-main">
        <!-- The keyword-bearing kicker is the H1; the slogan keeps the large visual treatment as a <p>. -->
        <h1 class="eyebrow hero-kicker">{homePage.hero.kicker}</h1>
        <p class="hero-title">{homePage.hero.title}</p>
        <p class="hero-copy">{homePage.hero.description}</p>

        <div class="hero-actions">
          <a class="button button-primary" href={withBase(homePage.hero.primaryCta.href)}>{homePage.hero.primaryCta.label}</a>
          <a class="hero-phone" href={phoneHref}>או בטלפון <span>{site.phone}</span></a>
        </div>
      </div>

      <figure class="hero-portrait">
        <div class="arch">
          <img src={heroImage} alt={`עו״ד ${site.shortName}`} width="800" height="1200" fetchpriority="high" decoding="async" />
        </div>
        <figcaption>
          <strong>{site.shortName}</strong>
          <span>עורכת דין ומגשרת לענייני משפחה</span>
        </figcaption>
      </figure>
    </div>

    <div class="container">
      <dl class="facts">
        {facts.map((fact) => (
          <div>
            <dt>{fact.term}</dt>
            <dd>{fact.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionHeading title="ליווי שמוריד עומס, מייצר בהירות, ועוזר לקבל החלטות טובות יותר" description={homePage.intro} />
      <div class="highlight-grid">
        {highlights.map((item) => (
          <article class="highlight">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about">
      <blockquote class="about-quote">
        <p>לא כל מקרה צריך עימות, ולא כל הסכמה היא בהכרח הסכמה נכונה.</p>
      </blockquote>
      <div class="about-body">
        <h2>עורכת דין ומגשרת שמלווה ברגישות, בנוכחות ובחשיבה לטווח ארוך</h2>
        <p>
          אני מלווה לקוחות בענייני גירושין, גישור משפחתי, משמורת, מזונות, חלוקת רכוש,
          צוואות, ירושות, ייפוי כוח מתמשך והסכמים, מתוך הקשבה אמיתית, סדר מחשבתי וראייה רחבה של התמונה כולה.
        </p>
        <p>
          הליווי נעשה באופן אישי וישיר, עם מטרה כפולה: להגן על האינטרסים המשפטיים שלך, ולהפחית ככל האפשר רעש,
          בלבול ועומס בתקופה שהיא ממילא רגישה ומורכבת.
        </p>
        <ul class="warmth-list">
          {warmth.map((line) => <li>{line}</li>)}
        </ul>
        <a class="text-link" href={withBase('/about')}>עוד על המשרד ועל הדרך שלי</a>
      </div>
    </div>
  </section>

  <section class="section services">
    <div class="container">
      <div class="services-head">
        <h2>תחומי עיסוק</h2>
        <p>הנושאים שמעסיקים לקוחות בתחילת הדרך. כל אחד מהם מקבל ליווי אישי, מההתייעצות הראשונה ועד הסיום.</p>
      </div>
      <ul class="service-list">
        {featuredServices.map((service) => (
          <li>
            <a href={withBase(service.href)}>
              <strong>{service.title}</strong>
              <span>{service.text}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="services-foot">
        <a class="button button-secondary" href={withBase('/practice-areas')}>כל תחומי העיסוק</a>
        <AreaLinks lead="המשרד בקדימה צורן מלווה גם את תושבי הסביבה:" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading title="כך נראה תהליך נכון, מסודר ורגוע יותר" description="הצעד הראשון הוא לא לרוץ, אלא להבין. משם אפשר לבחור דרך פעולה מדויקת יותר, עם פחות טעויות ויותר שקט." />
      <ol class="steps">
        {homePage.process.map((step, index) => (
          <li>
            <span class="step-letter" aria-hidden="true">{ordinals[index]}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Testimonials />

  <section class="section section-alt">
    <div class="container">
      <SectionHeading title="שאלות שעולות לפני פגישה, לפני החלטה ולפני צעד משפטי" description="תשובות ראשוניות, קצרות וברורות, בנושאים שעולים הרבה בתחילת הדרך." />
      <FaqPreview />
      <a class="text-link faq-more" href={withBase('/faq')}>לכל השאלות הנפוצות</a>
    </div>
  </section>

  <section class="closing">
    <div class="container closing-inner">
      <div>
        <h2>{homePage.cta.title}</h2>
        <p>{homePage.cta.text}</p>
      </div>
      <div class="closing-actions">
        <a class="closing-phone" href={phoneHref}>{site.phone}</a>
        <a class="button button-gold" href={withBase(homePage.cta.primary.href)}>{homePage.cta.primary.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero: paper background, a large display slogan, and the portrait set in
     an arch, the way a window frames a room. The arch's gold outline is the
     page's one load-time motion. */
  .hero {
    padding: 4.5rem 0 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.8fr);
    gap: 4.5rem;
    align-items: end;
  }

  .hero-main {
    padding-bottom: 2.5rem;
  }

  /* H1 shown as the small context line; reset the global h1 type. */
  .hero .hero-kicker {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
    margin-bottom: 1.75rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4.6vw, 4.5rem);
    line-height: 1.1;
    color: var(--color-text);
    max-width: 17ch;
    margin: 0 0 1.75rem;
    text-wrap: balance;
  }

  .hero-copy {
    font-size: 1.12rem;
    line-height: 1.9;
    max-width: 54ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }

  .hero-phone {
    color: var(--color-muted);
  }

  .hero-phone span {
    direction: ltr;
    display: inline-block;
    color: var(--color-text);
    font-weight: 600;
    border-bottom: 1px solid var(--color-primary);
    margin-inline-start: 0.35rem;
  }

  .hero-portrait {
    margin: 0;
  }

  .arch {
    position: relative;
    padding: 14px;
  }

  .arch::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--color-primary);
    border-radius: 999px 999px 0 0;
    animation: arch-draw 1400ms cubic-bezier(0.65, 0, 0.35, 1) 200ms both;
  }

  @keyframes arch-draw {
    from { clip-path: inset(100% 0 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }

  :root[data-a11y-reduce-motion] .arch::before {
    animation: none;
  }

  .arch img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 12%;
    border-radius: 999px 999px 0 0;
  }

  .hero-portrait figcaption {
    display: grid;
    padding: 1rem 0 0;
  }

  .hero-portrait figcaption strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.35rem;
  }

  .hero-portrait figcaption span {
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 3.5rem 0 0;
    border-top: 1px solid var(--color-border);
  }

  .facts div {
    padding: 1.5rem 0 1.75rem;
    padding-inline-end: 1.5rem;
  }

  .facts div + div {
    padding-inline-start: 1.5rem;
    border-inline-start: 1px solid var(--color-border);
  }

  .facts dt {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .facts dd {
    margin: 0.2rem 0 0;
    color: var(--color-muted);
  }

  /* Highlights: a gold hairline over each, no boxes. */
  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem;
    margin-top: 1rem;
  }

  .highlight {
    border-top: 1px solid var(--color-primary);
    padding-top: 1.25rem;
  }

  .highlight p {
    margin: 0;
    font-size: 0.98rem;
  }

  /* About */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 5rem;
    align-items: start;
  }

  .about-quote {
    margin: 0;
    position: sticky;
    top: 8rem;
  }

  .about-quote p {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3.2rem);
    line-height: 1.2;
    color: var(--color-pill-text);
    max-width: 14ch;
  }

  .about-body h2 {
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    margin-bottom: 1.5rem;
  }

  .warmth-list {
    list-style: none;
    margin: 2rem 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .warmth-list li {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .text-link {
    color: var(--color-text);
    font-weight: 600;
    border-bottom: 1px solid var(--color-primary);
    padding-bottom: 0.15rem;
  }

  .text-link:hover {
    color: var(--color-pill-text);
  }

  /* Practice areas: the one dark band on the page. */
  .services {
    background: var(--color-deep);
    color: var(--color-deep-text);
  }

  .services-head {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 5rem;
    align-items: end;
    margin-bottom: 3rem;
  }

  .services-head h2 {
    margin: 0;
    font-size: clamp(2.4rem, 4vw, 3.6rem);
  }

  .services-head p,
  .service-list span {
    color: var(--color-deep-muted);
    margin: 0;
  }

  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(232, 236, 230, 0.18);
  }

  .service-list a {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 5rem;
    align-items: baseline;
    padding: 1.6rem 0;
    border-bottom: 1px solid rgba(232, 236, 230, 0.18);
    transition: padding 200ms ease;
  }

  .service-list strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    line-height: 1.2;
    transition: color 160ms ease;
  }

  .service-list a:hover strong,
  .service-list a:focus-visible strong {
    color: #e5c47c;
  }

  .service-list a:hover {
    padding-inline-start: 0.75rem;
  }

  .services-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .services .button-secondary {
    color: var(--color-deep-text);
  }

  .services-foot :global(.area-links) {
    margin: 0;
  }

  .services-foot :global(.area-links-lead) {
    color: var(--color-deep-muted);
    font-weight: 400;
  }

  .services-foot :global(.area-links a) {
    color: var(--color-deep-text);
    border-color: rgba(229, 179, 74, 0.45);
  }

  .services-foot :global(.area-links a:hover) {
    background: rgba(229, 179, 74, 0.12);
  }

  /* Process: a real sequence, numbered with Hebrew letters. */
  .steps {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    counter-reset: none;
  }

  .steps li {
    position: relative;
  }

  .step-letter {
    display: block;
    font-family: var(--font-display);
    font-size: 4.2rem;
    line-height: 1;
    color: var(--color-primary);
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .steps p {
    margin: 0;
  }

  .faq-more {
    display: inline-block;
    margin-top: 2rem;
  }

  /* Closing call */
  .closing {
    background: var(--color-deep);
    color: var(--color-deep-text);
    padding: 5rem 0;
    border-bottom: 1px solid rgba(232, 236, 230, 0.1);
  }

  .closing-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) auto;
    gap: 3rem;
    align-items: end;
  }

  .closing h2 {
    font-size: clamp(2rem, 3.4vw, 3.1rem);
    max-width: 18ch;
  }

  .closing p {
    color: var(--color-deep-muted);
    margin: 0;
  }

  .closing-actions {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .closing-phone {
    direction: ltr;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3.6vw, 3.2rem);
    line-height: 1;
    color: #e5c47c;
  }

  .button-gold {
    background: #e5b34a;
    color: #1a1408;
  }

  .button-gold:hover {
    background: #f0c869;
  }

  @media (max-width: 1080px) {
    .highlight-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 2rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-main {
      padding-bottom: 0;
    }

    .hero .hero-kicker {
      font-size: 0.92rem;
      margin-bottom: 1.1rem;
    }

    .hero-title {
      font-size: clamp(2.1rem, 9vw, 2.7rem);
      margin-bottom: 1.1rem;
    }

    .hero-copy {
      font-size: 1rem;
      line-height: 1.8;
    }

    .hero-actions {
      margin-top: 1.5rem;
    }

    .hero-actions .button {
      width: 100%;
    }

    .hero-portrait {
      display: grid;
      grid-template-columns: 116px 1fr;
      gap: 1.1rem;
      align-items: end;
    }

    .arch {
      padding: 7px;
    }

    .hero-portrait figcaption {
      padding: 0 0 0.4rem;
    }

    .facts {
      grid-template-columns: 1fr;
      margin-top: 2rem;
    }

    .facts div,
    .facts div + div {
      padding: 1rem 0;
      border-inline-start: 0;
    }

    .facts div + div {
      border-top: 1px solid var(--color-border);
    }

    .facts dt {
      font-size: 1.35rem;
    }

    .highlight-grid,
    .steps {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about,
    .services-head,
    .service-list a,
    .closing-inner {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .about-quote {
      position: static;
    }

    .service-list a {
      gap: 0.35rem;
      padding: 1.25rem 0;
    }

    .service-list a:hover {
      padding-inline-start: 0;
    }

    .services-head {
      margin-bottom: 2rem;
    }

    .step-letter {
      font-size: 3.2rem;
    }

    .closing {
      padding: 3.5rem 0;
    }

    .closing-actions .button {
      width: 100%;
    }
  }
</style>
