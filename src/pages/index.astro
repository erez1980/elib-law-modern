---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FaqPreview from '../components/FaqPreview.astro';
import Testimonials from '../components/Testimonials.astro';
import AreaLinks from '../components/AreaLinks.astro';
import { highlights, site } from '../data/site';
import { homePage } from '../data/home';
import { withBase } from '../utils/url';

const heroImage = withBase(site.heroImage);
const trustBadges = [
  'חברת לשכת עורכי הדין משנת 2008',
  'ליווי אישי וישיר בכל תיק',
  'גישה משפטית וגישורית לפי מה שנכון למקרה',
];
const credibilityPoints = [
  'עו״ד ומגשרת לדיני משפחה',
  'סטנדרט מקצועי גבוה וליווי מוקפד',
  'רגישות, דיסקרטיות ושיקול דעת',
];
const featuredServices = [
  { title: 'גירושין', text: 'ליווי משפטי מדויק בתחילת הדרך, במו״מ, בגישור או בהליך משפטי.', href: '/services/divorce-lawyer' },
  { title: 'מזונות ומשמורת', text: 'בניית מסגרת ברורה ויציבה לילדים ולהורים, עם ראייה מעשית ואנושית.', href: '/services/custody-lawyer' },
  { title: 'צוואות וירושות', text: 'עריכת צוואות, ליווי בירושות וטיפול במחלוקות משפחתיות רגישות.', href: '/services/will-lawyer' },
  { title: 'ייפוי כוח מתמשך', text: 'תכנון משפטי אחראי שנותן שקט נפשי לעתיד.', href: '/services/lasting-power-attorney-lawyer' },
];
---
<BaseLayout>
  <section class="section hero-shell">
    <div class="container hero-grid">
      <div class="hero-main">
        <!-- The keyword-bearing kicker is the H1; the slogan keeps the large visual treatment as a <p>. -->
        <h1 class="eyebrow hero-kicker">{homePage.hero.kicker}</h1>
        <p class="hero-title">{homePage.hero.title}</p>
        <div class="hero-rule" aria-hidden="true"></div>
        <p class="hero-copy">{homePage.hero.description}</p>

        <div class="hero-actions">
          <a class="button button-primary" href={withBase(homePage.hero.primaryCta.href)}>{homePage.hero.primaryCta.label}</a>
          <a class="button button-secondary" href={withBase(homePage.hero.secondaryCta.href)}>{homePage.hero.secondaryCta.label}</a>
        </div>

        <ul class="hero-meta">
          {trustBadges.map((badge) => <li>{badge}</li>)}
        </ul>
      </div>

      <aside class="hero-stack">
        <div class="hero-image-frame">
          <img src={heroImage} alt={site.shortName} width="800" height="1200" fetchpriority="high" decoding="async" />
          <div class="hero-image-overlay">
            <strong>ליווי מקצועי, אישי ודיסקרטי</strong>
            <span>במצבים שבהם צריך גם בהירות משפטית וגם יד יציבה ורגישה</span>
          </div>
        </div>

        <div class="hero-credibility">
          {credibilityPoints.map((point) => (
            <div class="credibility-row">
              <span>{point}</span>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section trust-strip">
    <div class="container trust-band card">
      <div class="trust-copy">
        <div class="eyebrow">אמון, בהירות וגישה אנושית</div>
        <h2>ליווי משפטי שמחבר בין הבנה אנושית עמוקה לבין חשיבה משפטית שקולה ומדויקת</h2>
        <p>לא כל מקרה צריך עימות, ולא כל הסכמה היא בהכרח הסכמה נכונה. חשוב להבין מה ישרת אותך באמת, ולבנות משם דרך פעולה נכונה.</p>
      </div>
      <div class="trust-proof-list">
        <div class="trust-proof-item"><strong><span dir="ltr" data-countup="18" data-suffix="+">18+</span></strong><span>שנות ניסיון מקצועי</span></div>
        <div class="trust-proof-item"><strong>גישור + משפט</strong><span>בחירת הדרך המתאימה לכל מקרה</span></div>
        <div class="trust-proof-item"><strong>יחס אישי</strong><span>טיפול ישיר, רגיש ודיסקרטי</span></div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionHeading eyebrow="למה לפנות אליי" title="ליווי שמוריד עומס, מייצר בהירות, ועוזר לקבל החלטות טובות יותר" description={homePage.intro} />
      <div class="grid highlight-grid">
        {highlights.map((item) => (
          <article class="highlight-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-section">
      <div class="story-card card">
        <SectionHeading eyebrow="אודות" title="עורכת דין ומגשרת שמלווה ברגישות, בנוכחות, ובחשיבה לטווח ארוך" description="כשיש מתח, בלבול או חוסר ודאות, חשוב לעבוד עם מי שיודעת גם להחזיק את הסיטואציה האנושית וגם להוביל את המהלך המשפטי בצורה מדויקת." />
        <p>
          אני מלווה לקוחות בענייני גירושין, גישור משפחתי, משמורת, מזונות, חלוקת רכוש,
          צוואות, ירושות, ייפוי כוח מתמשך והסכמים - מתוך הקשבה אמיתית, סדר מחשבתי וראייה רחבה של התמונה כולה.
        </p>
        <p>
          הליווי נעשה באופן אישי וישיר, עם מטרה כפולה: גם להגן על האינטרסים המשפטיים שלך, וגם להפחית ככל האפשר רעש,
          בלבול ועומס בתקופה שהיא ממילא רגישה ומורכבת.
        </p>
      </div>
      <div class="card warmth-card">
        <h3 class="warmth-title">איך זה מרגיש בפועל</h3>
        <ul class="warmth-list">
          <li>שיחה ברורה, בלי מילים משפטיות שמעמיסות סתם</li>
          <li>בחינה אמיתית של האפשרויות, לא תגובה אוטומטית</li>
          <li>רגישות כשאפשר, ונחישות כשצריך</li>
          <li>תחושת סדר ובהירות כבר מהשלבים הראשונים</li>
        </ul>
        <a class="text-link" href={withBase('/about')}>לקריאה נוספת</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container areas-shell">
      <SectionHeading eyebrow="תחומי עיסוק" title="התחומים המרכזיים שבהם אני מלווה באופן אישי ומדויק" description="כאן אפשר למצוא את הנושאים המרכזיים שמעסיקים לקוחות בתחילת הדרך." />
      <div class="service-links-grid">
        {featuredServices.map((service) => (
          <a class="card service-link-card" href={withBase(service.href)}>
            <strong>{service.title}</strong>
            <span>{service.text}</span>
          </a>
        ))}
      </div>
      <div class="areas-footer-link">
        <a class="button button-secondary" href={withBase('/practice-areas')}>לכל תחומי הליווי</a>
      </div>
      <AreaLinks lead="המשרד בקדימה צורן מלווה גם את תושבי הסביבה:" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="תהליך העבודה" title="כך נראה תהליך נכון, מסודר ורגוע יותר" description="הצעד הראשון הוא לא לרוץ - אלא להבין. משם אפשר לבחור דרך פעולה מדויקת יותר, עם פחות טעויות ויותר שקט." />
      <ol class="process-steps">
        {homePage.process.map((step, index) => (
          <li class="process-step">
            <span class="step-index" aria-hidden="true">{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Testimonials />

  <section class="section section-alt">
    <div class="container faq-shell">
      <SectionHeading eyebrow="שאלות נפוצות" title="שאלות שאנשים שואלים כשהם רוצים להבין מה נכון לעשות עכשיו" description="תשובות ראשוניות, קצרות וברורות, בנושאים שעולים הרבה בתחילת הדרך - לפני פגישה, לפני החלטה, ולפני צעד משפטי." />
      <FaqPreview />
    </div>
  </section>

  <section class="section">
    <div class="container cta-banner card">
      <div>
        <div class="eyebrow">יצירת קשר</div>
        <h2>{homePage.cta.title}</h2>
        <p>{homePage.cta.text}</p>
      </div>
      <div class="hero-actions cta-actions">
        <a class="button button-primary" href={withBase(homePage.cta.primary.href)}>{homePage.cta.primary.label}</a>
        <a class="button button-secondary" href={withBase(homePage.cta.secondary.href)}>{homePage.cta.secondary.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Dark editorial hero — fixed charcoal+gold in both themes, echoing the logo */
  .hero-shell {
    position: relative;
    overflow: hidden;
    padding: 4.25rem 0 4.75rem;
    background:
      radial-gradient(ellipse 55% 60% at 12% 0%, rgba(201, 162, 75, 0.16), transparent 70%),
      linear-gradient(172deg, #151514 0%, #1d1a16 100%);
  }

  .hero-shell::after {
    content: '';
    position: absolute;
    left: -3%;
    bottom: -14%;
    width: 480px;
    height: 480px;
    background: url('/images/eb-monogram.svg') no-repeat center / contain;
    opacity: 0.055;
    pointer-events: none;
  }

  .hero-shell .hero-grid {
    position: relative;
    z-index: 1;
  }

  .hero-shell h1 {
    color: #f5f1e8;
  }

  /* H1 rendered as the small pill; reset the global h1 typography. */
  .hero-shell .hero-kicker {
    font-family: inherit;
    font-size: 0.9rem;
    line-height: 1.5;
    border-radius: 1.2rem;
  }

  /* Visual twin of the global h1 style, applied to the slogan paragraph. */
  .hero-title {
    font-family: 'Frank Ruhl Libre', 'Assistant', Georgia, serif;
    font-size: clamp(2rem, 3.1vw, 3.4rem);
    font-weight: 700;
    line-height: 1.24;
    letter-spacing: 0;
    margin: 0 0 1rem;
    color: #f5f1e8;
  }

  @media (max-width: 900px) {
    .hero-title {
      font-size: clamp(1.75rem, 8vw, 2.45rem);
    }
  }

  .hero-shell .eyebrow {
    background: rgba(201, 162, 75, 0.1);
    border-color: rgba(201, 162, 75, 0.42);
    color: #e5c47c;
    margin-bottom: 1.25rem;
  }

  .hero-rule {
    width: 76px;
    height: 2px;
    background: linear-gradient(to left, #c9a24b 0%, rgba(201, 162, 75, 0) 100%);
    margin: 1.15rem 0 1.2rem;
  }

  .hero-shell .hero-copy {
    color: rgba(245, 241, 232, 0.78);
  }

  .hero-shell .hero-meta {
    color: rgba(245, 241, 232, 0.92);
  }

  .hero-shell .button-primary {
    color: #221d13;
  }

  .hero-shell .button-secondary {
    border-color: rgba(255, 255, 255, 0.28);
    color: #f5f1e8;
    background: rgba(255, 255, 255, 0.04);
  }

  .hero-grid,
  .split-section {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 2rem;
    align-items: start;
  }

  .hero-main {
    padding-top: 1rem;
  }

  .hero-copy {
    font-size: 1.08rem;
    line-height: 1.95;
    max-width: 58ch;
    color: var(--color-soft-text);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 1.75rem 0;
  }

  .hero-meta {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .hero-meta li {
    position: relative;
    padding-right: 1.2rem;
  }

  .hero-meta li::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
    position: absolute;
    right: 0;
    top: 0.65rem;
  }

  .hero-stack {
    display: grid;
    gap: 1rem;
  }

  .service-link-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-strong);
    border-color: rgba(201, 162, 75, 0.4);
  }

  .hero-image-frame {
    position: relative;
  }

  .hero-image-frame::before {
    content: '';
    position: absolute;
    inset: 16px -16px -16px 16px;
    border: 1px solid rgba(201, 162, 75, 0.45);
    border-radius: 20px;
    pointer-events: none;
  }

  .hero-image-frame img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    border-radius: 20px;
    position: relative;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
  }

  .hero-image-overlay {
    position: absolute;
    right: 1.1rem;
    left: 1.1rem;
    bottom: 1.1rem;
    padding: 0.95rem 1.1rem;
    border-radius: 14px;
    background: rgba(16, 15, 14, 0.78);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(201, 162, 75, 0.28);
    color: #f5f1e8;
    display: grid;
    gap: 0.35rem;
  }

  .hero-image-overlay span {
    color: rgba(245, 241, 232, 0.75);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .hero-credibility {
    display: grid;
    gap: 0.75rem;
    padding: 1.2rem 1.4rem;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.09);
    backdrop-filter: blur(6px);
  }

  .credibility-row {
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    font-weight: 600;
    color: rgba(245, 241, 232, 0.88);
  }

  .credibility-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .trust-strip {
    padding-top: 1rem;
  }

  .trust-band {
    display: grid;
    gap: 1.75rem;
    padding: 2.25rem 2.5rem;
    background: var(--color-card-strong);
  }

  .trust-copy p {
    margin-bottom: 0;
  }

  .service-links-grid {
    display: grid;
    gap: 1rem;
  }

  .trust-proof-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .trust-proof-item {
    display: grid;
    gap: 0.2rem;
    align-content: start;
    padding-inline-start: 1.5rem;
    border-inline-start: 1px solid var(--color-border);
  }

  .trust-proof-item:first-child {
    padding-inline-start: 0;
    border-inline-start: 0;
  }

  .trust-proof-item strong {
    font-family: 'Frank Ruhl Libre', 'Assistant', Georgia, serif;
    font-size: 1.65rem;
    line-height: 1.3;
    color: var(--color-primary-deep);
  }

  .trust-proof-item > span {
    color: var(--color-muted);
  }

  .highlight-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 2rem;
  }

  .highlight-card {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-border);
    position: relative;
  }

  .highlight-card::before {
    content: '';
    position: absolute;
    top: -1px;
    inset-inline-start: 0;
    width: 48px;
    height: 2px;
    background: var(--color-primary);
  }

  .highlight-card h3 {
    margin-bottom: 0.4rem;
  }

  .highlight-card p {
    margin-bottom: 0;
  }

  .story-card,
  .warmth-card,
  .cta-banner {
    min-height: 100%;
  }

  .story-card {
    background: linear-gradient(180deg, var(--color-card-strong) 0%, var(--color-surface-warm) 100%);
  }

  /* Fixed charcoal in both themes, like the hero. */
  .warmth-card {
    background: linear-gradient(172deg, #1d1a16 0%, #151514 100%);
    border-color: rgba(201, 162, 75, 0.22);
    color: #f5f1e8;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    padding: 2rem;
  }

  .warmth-title {
    color: #e5c47c;
    margin: 0;
  }

  .warmth-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    align-content: start;
  }

  .warmth-list li {
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(245, 241, 232, 0.88);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .warmth-list li:last-child {
    border-bottom: 0;
  }

  .warmth-card .text-link {
    color: #e5c47c;
    font-weight: 700;
    justify-self: start;
    border-bottom: 1px solid rgba(229, 196, 124, 0.45);
  }

  .warmth-card .text-link:hover,
  .warmth-card .text-link:focus-visible {
    border-bottom-color: #e5c47c;
  }

  .story-card p,
  .highlight-card p,
  .process-step p,
  .cta-banner p,
  .warmth-card p {
    color: var(--color-soft-text);
    line-height: 1.9;
  }

  .split-section {
    grid-template-columns: 1.2fr 0.8fr;
  }

  .areas-shell,
  .faq-shell {
    display: grid;
    gap: 1.5rem;
  }

  .service-links-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .service-link-card {
    display: grid;
    gap: 0.35rem;
    padding: 1.5rem 1.75rem;
    background: var(--color-card-strong);
  }

  .service-link-card strong {
    font-family: 'Frank Ruhl Libre', 'Assistant', Georgia, serif;
    font-size: 1.35rem;
    line-height: 1.35;
  }

  .service-link-card span {
    color: var(--color-muted);
  }

  .service-link-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .areas-footer-link {
    display: flex;
    justify-content: center;
  }

  /* A real sequence, so the steps share one connecting line. */
  .process-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    position: relative;
  }

  .process-steps::before {
    content: '';
    position: absolute;
    top: 28px;
    /* Run from the first circle's centre to the last one's. */
    inset-inline-start: 28px;
    inset-inline-end: calc((100% - 5rem) / 3 - 28px);
    height: 1px;
    background: linear-gradient(to left, var(--color-primary), rgba(201, 162, 75, 0.25));
  }

  .process-step {
    position: relative;
  }

  .process-step h3 {
    margin-bottom: 0.6rem;
  }

  .process-step p {
    margin-bottom: 0;
  }

  .step-index {
    position: relative;
    display: inline-flex;
    width: 56px;
    height: 56px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-white);
    border: 1px solid var(--color-primary);
    color: var(--color-primary-deep);
    font-family: 'Frank Ruhl Libre', 'Assistant', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .cta-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    background: linear-gradient(120deg, #1f1f1f 0%, #2b2b2b 100%);
    color: white;
    border: 1px solid rgba(255,255,255,0.05);
    box-shadow: 0 24px 70px rgba(31,31,31,0.2);
  }

  .cta-banner p,
  .cta-banner h2 {
    color: white;
  }

  .cta-banner .eyebrow {
    color: #e5c47c;
    background: rgba(201, 162, 75, 0.14);
    border-color: rgba(201, 162, 75, 0.42);
  }

  .cta-banner .button-secondary {
    color: white;
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.08);
  }

  .cta-actions {
