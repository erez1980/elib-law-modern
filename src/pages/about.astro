---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';
import aboutPage from '../data/about-page.json';
import { withBase } from '../utils/url';

const heroImage = withBase(site.heroImage);
const workStyle = [
  'להתחיל מסדר ובהירות, לא מלחץ ומהירות',
  'להסתכל גם על ההשלכות האנושיות, לא רק על הסעיף המשפטי',
  'לשמור על דיסקרטיות, כבוד ותקשורת עניינית',
  'לבחור בכל פעם את הדרך שתשרת את הלקוח בצורה הנכונה ביותר',
];
---
<BaseLayout
  title="אודות | עו״ד אליזבט ברזאני דדון"
  description="עו״ד ומגשרת אליזבט ברזאני דדון, חברת לשכת עורכי הדין משנת 2008. ליווי אישי בדיני משפחה בקדימה צורן ובשרון, מתוך רגישות, דיסקרטיות וחשיבה לטווח ארוך."
>
  <PageHero eyebrow="אודות" title={aboutPage.title} description={aboutPage.description} />

  <section class="section about-hero">
    <div class="container about-grid">
      <div class="about-copy">
        {aboutPage.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="about-image-frame">
        <img src={heroImage} alt={site.shortName} width="800" height="1200" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container values-shell">
      <SectionHeading eyebrow="הגישה המקצועית" title="כך נראה ליווי משפטי שנשען גם על מקצועיות וגם על שיקול דעת" />
      <div class="values-grid">
        {aboutPage.values.map((value) => (
          <article class="card value-card">
            <h3>{value.title}</h3>
            <p>{value.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container authority-grid">
      <article class="card authority-card authority-card--main">
        <div class="eyebrow">מה חשוב בעבודה</div>
        <h2>לא רק לפתור את הבעיה המשפטית, אלא גם לעזור לעבור את התקופה הזאת בצורה נכונה יותר</h2>
        <ul class="work-style-list">
          {workStyle.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="card authority-card authority-card--side">
        <div class="eyebrow">למה לפנות אליי</div>
        <p>אני משלבת ניסיון מקצועי, גישור וייצוג משפטי, עם ליווי ישיר וחשיבה שמותאמת לכל מקרה לגופו.</p>
        <div class="mini-divider"></div>
        <div class="eyebrow">אזורי שירות</div>
        <p>אני מלווה לקוחות מקדימה צורן, אזור השרון ומקומות נוספים בארץ, בפגישות מסודרות וביחס אישי לאורך כל הדרך.</p>
      </article>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container about-cta card">
      <div>
        <div class="eyebrow">שיחה ראשונה</div>
        <h2>אם חשוב לך להבין מול מי עובדים ואיך נראה הליווי, אפשר להתחיל בשיחה רגועה וברורה</h2>
        <p>לפעמים שיחה אחת מסודרת כבר עושה הרבה סדר. אפשר לפנות, לשאול, להבין את האפשרויות, ולקבל כיוון ראשוני בלי לחץ מיותר.</p>
      </div>
      <a class="button button-primary" href={withBase('/contact')}>לתיאום שיחת ייעוץ</a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-grid,
  .values-grid,
  .authority-grid {
    display: grid;
    gap: 2rem;
  }

  .about-hero {
    padding-top: 3.5rem;
  }

  .about-grid {
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
  }

  .about-copy p {
    font-size: 1.05rem;
    line-height: 2;
  }

  .about-image-frame {
    position: relative;
    max-width: 420px;
    justify-self: center;
  }

  .about-image-frame::before {
    content: '';
    position: absolute;
    inset: 16px -16px -16px 16px;
    border: 1px solid rgba(201, 162, 75, 0.45);
    border-radius: 20px;
    pointer-events: none;
  }

  .about-image-frame img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    border-radius: 20px;
    box-shadow: var(--shadow-strong);
  }

  .values-shell {
    display: grid;
    gap: 1.5rem;
  }

  .values-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .authority-grid {
    grid-template-columns: 1.1fr 0.9fr;
    align-items: start;
  }

  .value-card,
  .authority-card,
  .about-cta {
    min-height: 100%;
  }

  .value-card {
    background: linear-gradient(180deg, var(--color-card) 0%, var(--color-surface-warm) 100%);
  }

  .authority-card--main {
    background: linear-gradient(180deg, var(--color-card-strong) 0%, var(--color-surface-warm) 100%);
  }

  .authority-card--side {
    background: linear-gradient(180deg, var(--color-card) 0%, var(--color-surface-warm) 100%);
  }

  .work-style-list {
    margin: 0;
    padding-right: 1.2rem;
    display: grid;
    gap: 0.8rem;
    color: var(--color-soft-text);
  }

  .mini-divider {
    width: 72px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-primary), transparent);
    margin: 1.15rem 0;
  }

  .about-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: linear-gradient(135deg, var(--color-surface-warm) 0%, var(--color-card-strong) 100%);
  }

  @media (max-width: 900px) {
    .about-grid,
    .values-grid,
    .authority-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .values-shell {
      gap: 1rem;
    }

    .about-hero {
      padding-top: 2rem;
    }

    .about-image-frame {
      max-width: 100%;
    }

    .about-image-frame::before {
      inset: 10px -10px -10px 10px;
      border-radius: 16px;
    }

    .about-image-frame img {
      aspect-ratio: 16 / 12;
      border-radius: 16px;
    }

    .about-cta {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }
  }
</style>
