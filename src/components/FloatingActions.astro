---
import WhatsappIcon from './WhatsappIcon.astro';
import { site } from '../data/site';

const phoneHref = `tel:${site.phone.replace(/-/g, '')}`;
const whatsappHref = site.whatsapp || phoneHref;
---
<div class="floating-actions">
  <a href={phoneHref} class="floating-chip">שיחה</a>
  <a href={whatsappHref} class="floating-chip floating-chip--whatsapp" target={site.whatsapp ? '_blank' : undefined} rel={site.whatsapp ? 'noreferrer' : undefined} aria-label="שליחת הודעת WhatsApp">
    <WhatsappIcon size={22} />
    <span>WhatsApp</span>
  </a>
</div>

<style>
  .floating-actions {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 30;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .floating-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 112px;
    min-height: 48px;
    padding: 0.8rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-deep);
    color: #ffffff;
    box-shadow: 0 10px 28px rgba(28, 39, 35, 0.18);
    font-weight: 600;
    backdrop-filter: blur(10px);
  }

  .floating-chip--whatsapp {
    background: var(--color-card-strong);
    color: #128c4a;
    border: 1px solid rgba(37, 211, 102, 0.35);
  }

  /* #128c4a is ~3.9:1 on the dark card; this lighter green clears 4.5:1 */
  :root[data-theme='dark'] .floating-chip--whatsapp {
    color: #4ccf83;
  }

  :root[data-theme='dark'] .floating-chip:not(.floating-chip--whatsapp) {
    background: var(--color-card-strong);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .floating-chip:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .floating-actions {
      left: 0;
      right: 0;
      bottom: 0;
      flex-direction: row;
      gap: 0;
      padding: 0.65rem 0.75rem calc(0.65rem + env(safe-area-inset-bottom));
      background: var(--color-header);
      border-top: 1px solid var(--color-header-border);
      backdrop-filter: blur(18px);
    }

    .floating-chip {
      flex: 1;
      min-width: 0;
      min-height: 52px;
      border-radius: var(--radius-sm);
      box-shadow: none;
    }

    .floating-chip + .floating-chip {
      margin-inline-start: 0.65rem;
    }
  }
</style>
