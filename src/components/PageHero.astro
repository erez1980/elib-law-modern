---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'right' | 'center';
}

const { eyebrow, title, description, align = 'right' } = Astro.props;
---
<section class={`page-hero ${align === 'center' ? 'center' : ''}`}>
  <div class="container">
    <div class="page-hero-inner">
      {eyebrow && <div class="eyebrow">{eyebrow}</div>}
      <h1>{title}</h1>
      {description && <p>{description}</p>}
    </div>
  </div>
</section>

<style>
  /* Inner-page opener: the same quiet paper as the homepage hero, with the
     title carried by the display face and a gold hairline underneath. */
  .page-hero {
    padding: 4.5rem 0 3.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero h1 {
    max-width: 20ch;
    margin-bottom: 1rem;
    text-wrap: balance;
  }

  .page-hero p {
    font-size: 1.12rem;
    line-height: 1.85;
    max-width: 58ch;
    margin-bottom: 0;
  }

  .page-hero.center .page-hero-inner {
    text-align: center;
  }

  .page-hero.center h1,
  .page-hero.center p {
    margin-inline: auto;
  }

  .page-hero.center .eyebrow {
    justify-content: center;
  }

  .page-hero.center .eyebrow::before {
    display: none;
  }

  @media (max-width: 900px) {
    .page-hero {
      padding: 2.5rem 0 2rem;
    }

    .page-hero h1 {
      max-width: 100%;
    }

    .page-hero p {
      font-size: 1rem;
      line-height: 1.75;
    }
  }
</style>
